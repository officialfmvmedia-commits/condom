{
  "name": "condom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_CONDOM_DEV_MOCKS=1 vite",
    "build": "tsc -b && vite build && node scripts/check-no-mocks.mjs",
    "check:mocks": "node scripts/check-no-mocks.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "shots": "node scripts/screenshots.mjs",
    "report": "tsx analyzer/src/cli.ts",
    "report:serve": "tsx analyzer/src/server.ts",
    "typecheck:analyzer": "tsc -p analyzer/tsconfig.json",
    "test": "vitest run",
    "simulate": "bash scripts/simulate.sh",
    "test:server": "npm --prefix server test"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^4.3.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.12"
  }
}
