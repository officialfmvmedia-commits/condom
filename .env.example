# Frontend (Render static site → Environment). Build-time. This is the ONLY production setting:
# all Solana RPC goes through ${VITE_API_URL}/rpc, so no RPC key is ever in the bundle.
VITE_API_URL=https://condom-api.onrender.com

# Local dev only (ignored by `vite build`): point the app at another RPC.
# VITE_RPC_URL=http://localhost:8899/rpc
